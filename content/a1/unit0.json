    "confusions": [
      {
        "pair": "E / I",
        "explain": "La E se dice «i» y la I se dice «ai». Truco: E de «email» → «i-meil»; I de «I am» → «ai am»."
      },
      {
        "pair": "G / J",
        "explain": "La G se dice «yi» y la J se dice «yei». Truco: G de «Gmail» → «yi-meil»; J de «jeans» → «yins», pero la letra es «yei»."
      },
      {
        "pair": "A / E / I",
        "explain": "A = «ei», E = «i», I = «ai». Es el trío que más se cruza al deletrear: practica «A, E, I» en voz alta hasta que salga solo."
      },
      {
        "pair": "Y",
        "explain": "La Y se dice «uai», como la palabra «why» (¿por qué?). No digas «i griega»."
      },
      {
        "pair": "W",
        "explain": "La W se dice «dábel-iu» (doble u). Es la letra más larga de decir: www se dice «dábel-iu, dábel-iu, dábel-iu»."
      },
      {
        "pair": "Z: zee / zed",
        "explain": "En Estados Unidos la Z es «zi» (zee); en el Reino Unido, Australia y Canadá es «zed». Las dos son correctas."
      }
    ],
