        {
          "order": 1,
          "title": "Humor e ironía",
          "theory_content": "El humor británico y estadounidense usa ironía, sarcasmo y understatement. La ironía dice lo contrario de lo que se piensa: What lovely weather! (bajo la lluvia). El sarcasmo es una ironía con intención hiriente. El understatement minimiza algo grande: It's a bit chilly (a −20 °C). Para detectarlos, mira el tono y el contexto.",
          "theory_table": [
            {
              "label": "Ironía",
              "value": "What lovely weather! (raining)"
            },
            {
              "label": "Sarcasmo",
              "value": "Oh, great job. (error enorme)"
            },
            {
              "label": "Understatement",
              "value": "It's a bit chilly. (−20 °C)"
            },
            {
              "label": "Juego de palabras",
              "value": "pun"
            }
          ],
          "practice_content": "Escribe un ejemplo de cada: ironía, sarcasmo y understatement.",
          "exercises": [
            {
              "type": "fill",
